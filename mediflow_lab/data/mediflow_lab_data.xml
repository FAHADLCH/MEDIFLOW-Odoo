<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_mediflow_lab_order" model="ir.sequence">
        <field name="name">MEDIFLOW Lab Order</field>
        <field name="code">mediflow.lab.order</field>
        <field name="prefix">LAB/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_mediflow_specimen" model="ir.sequence">
        <field name="name">MEDIFLOW Specimen Accession</field>
        <field name="code">mediflow.specimen</field>
        <field name="prefix">SP/%(year)s/</field>
        <field name="padding">7</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
