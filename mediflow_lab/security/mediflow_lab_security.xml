<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Company isolation floor for all lab models -->
    <record id="rule_lab_test_company" model="ir.rule">
        <field name="name">Lab Test: company isolation</field>
        <field name="model_id" ref="model_mediflow_lab_test"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_lab_panel_company" model="ir.rule">
        <field name="name">Lab Panel: company isolation</field>
        <field name="model_id" ref="model_mediflow_lab_panel"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_lab_order_company" model="ir.rule">
        <field name="name">Lab Order: company isolation</field>
        <field name="model_id" ref="model_mediflow_lab_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_specimen_company" model="ir.rule">
        <field name="name">Specimen: company isolation</field>
        <field name="model_id" ref="model_mediflow_specimen"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_lab_result_company" model="ir.rule">
        <field name="name">Lab Result: company isolation</field>
        <field name="model_id" ref="model_mediflow_lab_result"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
