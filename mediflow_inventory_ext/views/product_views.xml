<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_mediflow" model="ir.ui.view">
        <field name="name">product.template.form.mediflow</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Medication" name="mediflow_medication"
                      invisible="not is_medication and type == 'service'">
                    <group>
                        <group string="Classification">
                            <field name="is_medication"/>
                            <field name="drug_class" invisible="not is_medication"/>
                            <field name="dosage_form" invisible="not is_medication"/>
                            <field name="strength" invisible="not is_medication"/>
                        </group>
                        <group string="Coding &amp; Controls">
                            <field name="atc_code" invisible="not is_medication"/>
                            <field name="rxnorm_code" invisible="not is_medication"/>
                            <field name="prescription_required" invisible="not is_medication"/>
                            <field name="is_controlled" invisible="not is_medication"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
