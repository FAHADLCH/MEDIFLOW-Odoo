<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_mediflow" model="ir.ui.view">
        <field name="name">account.move.form.mediflow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="is_mediflow_invoice" invisible="1"/>
                <field name="mediflow_patient_id"
                       invisible="not is_mediflow_invoice"
                       readonly="state != 'draft'"/>
                <field name="mediflow_encounter_id"
                       invisible="not is_mediflow_invoice"
                       readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

    <record id="action_mediflow_patient_invoices" model="ir.actions.act_window">
        <field name="name">Patient Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_mediflow_invoice', '=', True), ('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_is_mediflow_invoice': True}</field>
    </record>

</odoo>
