<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_encounter_form_billing" model="ir.ui.view">
        <field name="name">mediflow.encounter.form.billing</field>
        <field name="model">mediflow.encounter</field>
        <field name="inherit_id" ref="mediflow_emr.view_mediflow_encounter_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_add_consultation_charge" type="object"
                        string="Add Consultation Charge"
                        invisible="state not in ('in_progress', 'completed')"
                        groups="mediflow_base.group_mediflow_cashier,mediflow_base.group_mediflow_doctor"/>
                <button name="action_create_invoice" type="object"
                        string="Create Invoice" class="btn-secondary"
                        invisible="invoice_id != False or state == 'planned'"
                        groups="mediflow_base.group_mediflow_cashier"/>
                <button name="action_view_invoice" type="object"
                        string="View Invoice"
                        invisible="invoice_id == False"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Charges &amp; Billing" name="billing"
                      groups="mediflow_base.group_mediflow_cashier,mediflow_base.group_mediflow_doctor">
                    <field name="invoice_id" invisible="1"/>
                    <field name="charge_item_ids" context="{'default_patient_id': patient_id, 'default_encounter_id': id}">
                        <list editable="bottom">
                            <field name="charge_master_id"/>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount" sum="Total"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="charge_total"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
