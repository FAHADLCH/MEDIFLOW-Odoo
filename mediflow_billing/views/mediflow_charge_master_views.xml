<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_charge_master_list" model="ir.ui.view">
        <field name="name">mediflow.charge.master.list</field>
        <field name="model">mediflow.charge.master</field>
        <field name="arch" type="xml">
            <list string="Charge Master" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="price"/>
                <field name="product_id"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_charge_master_search" model="ir.ui.view">
        <field name="name">mediflow.charge.master.search</field>
        <field name="model">mediflow.charge.master</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mediflow_charge_master" model="ir.actions.act_window">
        <field name="name">Charge Master</field>
        <field name="res_model">mediflow.charge.master</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
