<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Multi-tenant isolation: each reporting view is scoped to the user's
         allowed companies, mirroring the isolation on the underlying tables. -->

    <record id="rule_v_queue_metrics_company" model="ir.rule">
        <field name="name">Queue Metrics: company isolation</field>
        <field name="model_id" ref="model_mediflow_v_queue_metrics"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_v_appointment_util_company" model="ir.rule">
        <field name="name">Appointment Utilization: company isolation</field>
        <field name="model_id" ref="model_mediflow_v_appointment_util"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_v_lab_tat_company" model="ir.rule">
        <field name="name">Lab TAT: company isolation</field>
        <field name="model_id" ref="model_mediflow_v_lab_tat"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_v_revenue_company" model="ir.rule">
        <field name="name">Revenue Cycle: company isolation</field>
        <field name="model_id" ref="model_mediflow_v_revenue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_v_claims_company" model="ir.rule">
        <field name="name">Claims: company isolation</field>
        <field name="model_id" ref="model_mediflow_v_claims"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_v_clinical_quality_company" model="ir.rule">
        <field name="name">Clinical Quality: company isolation</field>
        <field name="model_id" ref="model_mediflow_v_clinical_quality"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
