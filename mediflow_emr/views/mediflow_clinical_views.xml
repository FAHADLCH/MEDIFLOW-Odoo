<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone immunization registry (nurse/doctor) -->
    <record id="view_mediflow_immunization_tree" model="ir.ui.view">
        <field name="name">mediflow.immunization.tree</field>
        <field name="model">mediflow.immunization</field>
        <field name="arch" type="xml">
            <list string="Immunizations">
                <field name="administered_date"/>
                <field name="patient_id"/>
                <field name="name"/>
                <field name="dose_number"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_immunization_form" model="ir.ui.view">
        <field name="name">mediflow.immunization.form</field>
        <field name="model">mediflow.immunization</field>
        <field name="arch" type="xml">
            <form string="Immunization">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="name"/>
                            <field name="vaccine_code"/>
                            <field name="dose_number"/>
                        </group>
                        <group>
                            <field name="administered_date"/>
                            <field name="lot_number"/>
                            <field name="administered_by_id"/>
                            <field name="status"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mediflow_immunization" model="ir.actions.act_window">
        <field name="name">Immunizations</field>
        <field name="res_model">mediflow.immunization</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'phi_audit_read': True}</field>
    </record>

    <!-- Consent registry (reception/compliance) -->
    <record id="view_mediflow_consent_tree" model="ir.ui.view">
        <field name="name">mediflow.consent.tree</field>
        <field name="model">mediflow.consent</field>
        <field name="arch" type="xml">
            <list string="Consents">
                <field name="patient_id"/>
                <field name="scope"/>
                <field name="state" decoration-success="state == 'active'" decoration-danger="state == 'revoked'"/>
                <field name="granted_date"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_consent_form" model="ir.ui.view">
        <field name="name">mediflow.consent.form</field>
        <field name="model">mediflow.consent</field>
        <field name="arch" type="xml">
            <form string="Consent">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_revoke" type="object" string="Revoke"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="scope"/>
                            <field name="document_id"/>
                        </group>
                        <group>
                            <field name="granted_date"/>
                            <field name="expiry_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mediflow_consent" model="ir.actions.act_window">
        <field name="name">Consents</field>
        <field name="res_model">mediflow.consent</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'phi_audit_read': True}</field>
    </record>

</odoo>
