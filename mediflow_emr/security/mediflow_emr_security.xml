<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================
         Global multi-company isolation floor for all EMR PHI models.
         No row leaks across clinics regardless of role.
         ============================================================ -->
    <record id="rule_patient_company" model="ir.rule">
        <field name="name">Patient: multi-clinic isolation</field>
        <field name="model_id" ref="model_mediflow_patient"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_encounter_company" model="ir.rule">
        <field name="name">Encounter: multi-clinic isolation</field>
        <field name="model_id" ref="model_mediflow_encounter"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_problem_company" model="ir.rule">
        <field name="name">Problem: multi-clinic isolation</field>
        <field name="model_id" ref="model_mediflow_problem"/>
