<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="rule_queue_company" model="ir.rule">
        <field name="name">Queue: multi-clinic isolation</field>
        <field name="model_id" ref="model_mediflow_queue"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_queue_entry_company" model="ir.rule">
        <field name="name">Queue Entry: multi-clinic isolation</field>
        <field name="model_id" ref="model_mediflow_queue_entry"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
