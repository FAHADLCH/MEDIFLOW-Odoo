<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- ===================== Module category ===================== -->
    <record id="module_category_mediflow" model="ir.module.category">
        <field name="name">MEDIFLOW</field>
        <field name="description">Healthcare clinic and diagnostics platform roles</field>
        <field name="sequence">10</field>
    </record>

    <!-- ===================== Role groups ===================== -->
    <record id="group_mediflow_reception" model="res.groups">
        <field name="name">Reception / Front Desk</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mediflow_nurse" model="res.groups">
        <field name="name">Nurse / Medical Assistant</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('group_mediflow_reception'))]"/>
    </record>

    <record id="group_mediflow_doctor" model="res.groups">
        <field name="name">Doctor / Practitioner</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('group_mediflow_nurse'))]"/>
    </record>

    <record id="group_mediflow_lab_tech" model="res.groups">
        <field name="name">Lab Technician</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mediflow_lab_verifier" model="res.groups">
        <field name="name">Lab Verifier / Pathologist</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('group_mediflow_lab_tech'))]"/>
    </record>

    <record id="group_mediflow_pharmacist" model="res.groups">
        <field name="name">Pharmacist</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mediflow_cashier" model="res.groups">
        <field name="name">Billing / Cashier</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mediflow_insurance" model="res.groups">
        <field name="name">Insurance Coordinator</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('group_mediflow_cashier'))]"/>
    </record>

    <record id="group_mediflow_inventory" model="res.groups">
        <field name="name">Inventory Manager</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mediflow_compliance" model="res.groups">
        <field name="name">Compliance Officer</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mediflow_clinic_manager" model="res.groups">
        <field name="name">Clinic Manager</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('group_mediflow_doctor')), (4, ref('group_mediflow_cashier'))]"/>
    </record>

    <record id="group_mediflow_breakglass" model="res.groups">
        <field name="name">Break-Glass Emergency Access</field>
        <field name="category_id" ref="module_category_mediflow"/>
    </record>

    <record id="group_mediflow_admin" model="res.groups">
        <field name="name">MEDIFLOW Administrator</field>
        <field name="category_id" ref="module_category_mediflow"/>
        <field name="implied_ids" eval="[(4, ref('group_mediflow_clinic_manager')), (4, ref('group_mediflow_lab_verifier')), (4, ref('group_mediflow_pharmacist')), (4, ref('group_mediflow_insurance')), (4, ref('group_mediflow_inventory')), (4, ref('group_mediflow_compliance'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
