<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FHIR tokens are global infrastructure (not patient data), but we still
         scope them to the issuing company so one clinic's admin does not manage
         another's API credentials. -->
    <record id="rule_fhir_token_company" model="ir.rule">
        <field name="name">FHIR Token: company isolation</field>
        <field name="model_id" ref="model_mediflow_fhir_token"/>
        <field name="domain_force">[
            '|',
                ('user_id.company_id', 'in', company_ids),
                ('user_id', '=', user.id),
        ]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
