<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_practitioner_tree" model="ir.ui.view">
        <field name="name">mediflow.practitioner.tree</field>
        <field name="model">mediflow.practitioner</field>
        <field name="arch" type="xml">
            <list string="Practitioners">
                <field name="name"/>
                <field name="role"/>
                <field name="specialty_id"/>
                <field name="license_number"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_practitioner_form" model="ir.ui.view">
        <field name="name">mediflow.practitioner.form</field>
        <field name="model">mediflow.practitioner</field>
        <field name="arch" type="xml">
            <form string="Practitioner">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="role"/>
                            <field name="specialty_id"/>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="license_number"/>
                            <field name="npi"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mediflow_practitioner" model="ir.actions.act_window">
        <field name="name">Practitioners</field>
        <field name="res_model">mediflow.practitioner</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mediflow_specialty_tree" model="ir.ui.view">
        <field name="name">mediflow.specialty.tree</field>
        <field name="model">mediflow.specialty</field>
        <field name="arch" type="xml">
            <list string="Specialties" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_mediflow_specialty" model="ir.actions.act_window">
        <field name="name">Specialties</field>
        <field name="res_model">mediflow.specialty</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
