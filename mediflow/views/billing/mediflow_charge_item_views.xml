<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_charge_item_list" model="ir.ui.view">
        <field name="name">mediflow.charge.item.list</field>
        <field name="model">mediflow.charge.item</field>
        <field name="arch" type="xml">
            <list string="Charge Items">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="encounter_id"/>
                <field name="category"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="amount" sum="Total"/>
                <field name="invoice_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'billed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_charge_item_form" model="ir.ui.view">
        <field name="name">mediflow.charge.item.form</field>
        <field name="model">mediflow.charge.item</field>
        <field name="arch" type="xml">
            <form string="Charge Item">
                <header>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="charge_master_id"/>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="encounter_id"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mediflow_charge_item_search" model="ir.ui.view">
        <field name="name">mediflow.charge.item.search</field>
        <field name="model">mediflow.charge.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="encounter_id"/>
                <filter name="draft" string="Unbilled" domain="[('state', '=', 'draft')]"/>
                <filter name="billed" string="Billed" domain="[('state', '=', 'billed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mediflow_charge_item" model="ir.actions.act_window">
        <field name="name">Charge Items</field>
        <field name="res_model">mediflow.charge.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
    </record>

</odoo>
