<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_encounter_form_ai" model="ir.ui.view">
        <field name="name">mediflow.encounter.form.ai</field>
        <field name="model">mediflow.encounter</field>
        <field name="inherit_id" ref="mediflow.view_mediflow_encounter_form"/>
        <field name="arch" type="xml">

            <!-- AI draft button in the header -->
            <button name="action_amend" position="after">
                <button name="action_mf_ai_draft_summary" type="object"
                        string="AI Draft Summary" class="btn-secondary"
                        invisible="state not in ('in_progress','completed')"/>
            </button>

            <!-- Triage suggestion next to the chief complaint -->
            <field name="reason" position="after">
                <field name="mf_acuity_suggestion" widget="badge"
                       decoration-success="mf_acuity_suggestion == 'routine'"
                       decoration-warning="mf_acuity_suggestion == 'urgent'"
                       decoration-danger="mf_acuity_suggestion == 'emergent'"/>
                <field name="mf_acuity_rationale"/>
            </field>

            <!-- AI Assist page -->
            <page name="documents" position="after">
                <page string="AI Assist" name="ai_assist">
                    <div class="alert alert-warning" role="alert"
                         invisible="not mf_ai_summary">
                        AI-generated draft. A clinician must review, edit and sign
                        before this is used in the record.
                    </div>
                    <group>
                        <field name="mf_ai_summary_source" readonly="1"
                               invisible="not mf_ai_summary"/>
                        <field name="mf_ai_summary_date" readonly="1"
                               invisible="not mf_ai_summary"/>
                    </group>
                    <field name="mf_ai_summary" placeholder="Use 'AI Draft Summary' to generate a reviewable draft from this encounter's structured data."/>
                </page>
            </page>

        </field>
    </record>

</odoo>
