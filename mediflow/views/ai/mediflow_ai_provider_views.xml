<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_ai_provider_list" model="ir.ui.view">
        <field name="name">mediflow.ai.provider.list</field>
        <field name="model">mediflow.ai.provider</field>
        <field name="arch" type="xml">
            <list string="AI Providers">
                <field name="name"/>
                <field name="provider_type"/>
                <field name="model_name"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_ai_provider_form" model="ir.ui.view">
        <field name="name">mediflow.ai.provider.form</field>
        <field name="model">mediflow.ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Clinic GPT"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider_type"/>
                            <field name="model_name"/>
                            <field name="api_base_url"
                                   placeholder="https://api.openai.com/v1"/>
                            <field name="api_key" password="True"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                            <field name="temperature"/>
                            <field name="max_tokens"/>
                            <field name="request_timeout"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Narrative features de-identify and consent-gate data before
                        any call. Predictive features (no-show, triage) never use this
                        provider and run fully offline.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mediflow_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">mediflow.ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
