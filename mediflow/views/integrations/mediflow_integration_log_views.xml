<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_integration_log_list" model="ir.ui.view">
        <field name="name">mediflow.integration.log.list</field>
        <field name="model">mediflow.integration.log</field>
        <field name="arch" type="xml">
            <list string="Integration Log" create="false" edit="false">
                <field name="create_date"/>
                <field name="integration_type"/>
                <field name="direction"/>
                <field name="channel"/>
                <field name="reference"/>
                <field name="patient_id"/>
                <field name="status" decoration-success="status == 'ok'"
                       decoration-warning="status == 'skipped'"
                       decoration-danger="status == 'error'" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_integration_log_form" model="ir.ui.view">
        <field name="name">mediflow.integration.log.form</field>
        <field name="model">mediflow.integration.log</field>
        <field name="arch" type="xml">
            <form string="Integration Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="integration_id"/>
                            <field name="integration_type"/>
                            <field name="direction"/>
                            <field name="channel"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="reference"/>
                            <field name="patient_id"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request"><field name="request_excerpt"/></page>
                        <page string="Response"><field name="response_excerpt"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mediflow_integration_log" model="ir.actions.act_window">
        <field name="name">Integration Log</field>
        <field name="res_model">mediflow.integration.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
