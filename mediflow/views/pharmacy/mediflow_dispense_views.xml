<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_dispense_list" model="ir.ui.view">
        <field name="name">mediflow.dispense.list</field>
        <field name="model">mediflow.dispense</field>
        <field name="arch" type="xml">
            <list string="Dispenses">
                <field name="name"/>
                <field name="dispensed_at"/>
                <field name="prescription_id"/>
                <field name="patient_id"/>
                <field name="dispensed_by_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_dispense_form" model="ir.ui.view">
        <field name="name">mediflow.dispense.form</field>
        <field name="model">mediflow.dispense</field>
        <field name="arch" type="xml">
            <form string="Dispense">
                <header>
                    <button name="action_confirm" type="object" string="Confirm (FEFO)"
                            class="oe_highlight" invisible="state != 'draft'"
                            help="Allocate earliest-expiry lots; expired stock is excluded."/>
                    <button name="action_done" type="object" string="Validate &amp; Issue"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="prescription_id" readonly="1"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="dispensed_by_id"/>
                        </group>
                        <group>
                            <field name="location_id" readonly="state != 'draft'"/>
                            <field name="dispensed_at" readonly="1"/>
                            <field name="picking_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="lot_id" readonly="1"/>
                            <field name="lot_allocation" readonly="1"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Counseling notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mediflow_dispense_search" model="ir.ui.view">
        <field name="name">mediflow.dispense.search</field>
        <field name="model">mediflow.dispense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="prescription_id"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="pending" string="Pending"
                        domain="[('state', 'in', ('draft', 'confirmed'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mediflow_dispense" model="ir.actions.act_window">
        <field name="name">Dispenses</field>
        <field name="res_model">mediflow.dispense</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
