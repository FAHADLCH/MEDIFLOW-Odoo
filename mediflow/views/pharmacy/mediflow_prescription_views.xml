<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_prescription_list" model="ir.ui.view">
        <field name="name">mediflow.prescription.list</field>
        <field name="model">mediflow.prescription</field>
        <field name="arch" type="xml">
            <list string="Prescriptions" decoration-warning="warning_text and state == 'draft'">
                <field name="name"/>
                <field name="prescribed_date"/>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <field name="dispense_count"/>
                <field name="warning_text" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('dispensed', 'handed_over')"
                       decoration-info="state == 'ordered'"
                       decoration-warning="state == 'partially_dispensed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_prescription_form" model="ir.ui.view">
        <field name="name">mediflow.prescription.form</field>
        <field name="model">mediflow.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <header>
                    <button name="action_order" type="object" string="Sign &amp; Order"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_new_dispense" type="object" string="Dispense"
                            class="oe_highlight"
                            invisible="state not in ('ordered', 'partially_dispensed')"
                            groups="mediflow.group_mediflow_pharmacist"/>
                    <button name="action_hand_over" type="object" string="Hand Over"
                            invisible="state != 'dispensed'"
                            groups="mediflow.group_mediflow_pharmacist"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('handed_over', 'cancelled')"
                            confirm="Cancel this prescription?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ordered,dispensed,handed_over"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_mediflow_dispense)d" type="action"
                                class="oe_stat_button" icon="fa-pills"
                                context="{'search_default_prescription_id': id}">
                            <field name="dispense_count" widget="statinfo" string="Dispenses"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not warning_text">
                        <strong>Safety warnings:</strong>
                        <field name="warning_text" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" readonly="state != 'draft'"/>
                            <field name="encounter_id" readonly="state != 'draft'"/>
                            <field name="practitioner_id"/>
                        </group>
                        <group>
                            <field name="prescribed_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Medications" name="medications">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="dose"/>
                                    <field name="frequency"/>
                                    <field name="route"/>
                                    <field name="duration_days"/>
                                    <field name="quantity"/>
                                    <field name="instructions"/>
                                </list>
                            </field>
                        </page>
                        <page string="Safety Override" name="override"
                              groups="mediflow.group_mediflow_doctor">
                            <group>
                                <field name="override_warnings"
                                       readonly="state != 'draft'"/>
                                <field name="override_reason"
                                       readonly="state != 'draft'"
                                       invisible="not override_warnings"
                                       required="override_warnings"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                            <group invisible="state != 'cancelled'">
                                <field name="cancel_reason"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mediflow_prescription_search" model="ir.ui.view">
        <field name="name">mediflow.prescription.search</field>
        <field name="model">mediflow.prescription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <filter name="open" string="Open"
                        domain="[('state', 'not in', ('handed_over', 'cancelled'))]"/>
                <filter name="to_dispense" string="To Dispense"
                        domain="[('state', 'in', ('ordered', 'partially_dispensed'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mediflow_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">mediflow.prescription</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

</odoo>
