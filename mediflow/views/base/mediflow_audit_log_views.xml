<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_audit_log_tree" model="ir.ui.view">
        <field name="name">mediflow.audit.log.tree</field>
        <field name="model">mediflow.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log" create="false" edit="false" delete="false">
                <field name="timestamp"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="action"/>
                <field name="model"/>
                <field name="res_id"/>
                <field name="patient_id"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_audit_log_form" model="ir.ui.view">
        <field name="name">mediflow.audit.log.form</field>
        <field name="model">mediflow.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Entry" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="timestamp"/>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="action"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="res_id"/>
                            <field name="patient_id"/>
                            <field name="ip_address"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                    <group string="Field Changes">
                        <field name="field_changes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mediflow_audit_log_search" model="ir.ui.view">
        <field name="name">mediflow.audit.log.search</field>
        <field name="model">mediflow.audit.log</field>
        <field name="arch" type="xml">
            <search string="Audit Log">
                <field name="user_id"/>
                <field name="patient_id"/>
                <field name="model"/>
                <filter name="break_glass" string="Break-Glass" domain="[('action','=','break_glass')]"/>
                <filter name="exports" string="Exports" domain="[('action','=','export')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="User" context="{'group_by':'user_id'}"/>
                    <filter name="group_action" string="Action" context="{'group_by':'action'}"/>
                    <filter name="group_model" string="Model" context="{'group_by':'model'}"/>
                    <filter name="group_company" string="Clinic" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mediflow_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">mediflow.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mediflow_audit_log_search"/>
    </record>

</odoo>
