<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_specimen_list" model="ir.ui.view">
        <field name="name">mediflow.specimen.list</field>
        <field name="model">mediflow.specimen</field>
        <field name="arch" type="xml">
            <list string="Specimens">
                <field name="name"/>
                <field name="order_id"/>
                <field name="patient_id"/>
                <field name="specimen_type"/>
                <field name="collected_at"/>
                <field name="received_at"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'received'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_specimen_form" model="ir.ui.view">
        <field name="name">mediflow.specimen.form</field>
        <field name="model">mediflow.specimen</field>
        <field name="arch" type="xml">
            <form string="Specimen">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="patient_id"/>
                            <field name="specimen_type"/>
                            <field name="container"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="collected_at"/>
                            <field name="collected_by_id"/>
                            <field name="received_at"/>
                        </group>
                    </group>
                    <group invisible="state != 'rejected'">
                        <field name="reject_reason"/>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mediflow_specimen" model="ir.actions.act_window">
        <field name="name">Specimens</field>
        <field name="res_model">mediflow.specimen</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
