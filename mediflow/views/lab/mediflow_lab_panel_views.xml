<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_lab_panel_list" model="ir.ui.view">
        <field name="name">mediflow.lab.panel.list</field>
        <field name="model">mediflow.lab.panel</field>
        <field name="arch" type="xml">
            <list string="Lab Panels">
                <field name="code"/>
                <field name="name"/>
                <field name="loinc_code"/>
                <field name="test_count"/>
                <field name="price"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_lab_panel_form" model="ir.ui.view">
        <field name="name">mediflow.lab.panel.form</field>
        <field name="model">mediflow.lab.panel</field>
        <field name="arch" type="xml">
            <form string="Lab Panel">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Panel name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="loinc_code"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="test_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mediflow_lab_panel" model="ir.actions.act_window">
        <field name="name">Lab Panels</field>
        <field name="res_model">mediflow.lab.panel</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
