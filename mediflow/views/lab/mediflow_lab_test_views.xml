<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_lab_test_list" model="ir.ui.view">
        <field name="name">mediflow.lab.test.list</field>
        <field name="model">mediflow.lab.test</field>
        <field name="arch" type="xml">
            <list string="Lab Tests">
                <field name="code"/>
                <field name="name"/>
                <field name="loinc_code"/>
                <field name="specimen_type"/>
                <field name="result_type"/>
                <field name="uom_name"/>
                <field name="ref_low"/>
                <field name="ref_high"/>
                <field name="tat_hours"/>
                <field name="price"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_lab_test_form" model="ir.ui.view">
        <field name="name">mediflow.lab.test.form</field>
        <field name="model">mediflow.lab.test</field>
        <field name="arch" type="xml">
            <form string="Lab Test">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Test name"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="loinc_code"/>
                            <field name="specimen_type"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Result">
                            <field name="result_type"/>
                            <field name="uom_name"/>
                            <field name="tat_hours"/>
                            <field name="price"/>
                        </group>
                    </group>
                    <group string="Reference &amp; Critical Ranges (numeric)"
                           invisible="result_type != 'numeric'">
                        <group>
                            <field name="ref_low"/>
                            <field name="ref_high"/>
                        </group>
                        <group>
                            <field name="critical_low"/>
                            <field name="critical_high"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mediflow_lab_test_search" model="ir.ui.view">
        <field name="name">mediflow.lab.test.search</field>
        <field name="model">mediflow.lab.test</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="loinc_code"/>
                <filter name="numeric" string="Numeric" domain="[('result_type', '=', 'numeric')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_specimen" string="Specimen Type"
                            context="{'group_by': 'specimen_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mediflow_lab_test" model="ir.actions.act_window">
        <field name="name">Lab Tests</field>
        <field name="res_model">mediflow.lab.test</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
