<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_mediflow_appointment" model="ir.sequence">
        <field name="name">MEDIFLOW Appointment</field>
        <field name="code">mediflow.appointment</field>
        <field name="prefix">APT/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cron_generate_slots" model="ir.cron">
        <field name="name">MEDIFLOW: Generate Appointment Slots</field>
        <field name="model_id" ref="model_mediflow_schedule"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_slots(days_ahead=14)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_mark_no_show" model="ir.cron">
        <field name="name">MEDIFLOW: Mark No-show Appointments</field>
        <field name="model_id" ref="model_mediflow_appointment"/>
        <field name="state">code</field>
        <field name="code">model.cron_mark_no_show(grace_minutes=30)</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
