<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="rule_payer_company" model="ir.rule">
        <field name="name">Payer: company isolation</field>
        <field name="model_id" ref="model_mediflow_payer"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_coverage_company" model="ir.rule">
        <field name="name">Coverage: company isolation</field>
        <field name="model_id" ref="model_mediflow_coverage"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_preauth_company" model="ir.rule">
        <field name="name">Pre-Auth: company isolation</field>
        <field name="model_id" ref="model_mediflow_preauth"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_claim_company" model="ir.rule">
        <field name="name">Claim: company isolation</field>
        <field name="model_id" ref="model_mediflow_claim"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
