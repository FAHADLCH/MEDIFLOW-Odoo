<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_mediflow_prescription" model="ir.sequence">
        <field name="name">MEDIFLOW Prescription</field>
        <field name="code">mediflow.prescription</field>
        <field name="prefix">RX/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_mediflow_dispense" model="ir.sequence">
        <field name="name">MEDIFLOW Dispense</field>
        <field name="code">mediflow.dispense</field>
        <field name="prefix">DSP/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
