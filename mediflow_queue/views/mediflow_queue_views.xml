<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_queue_tree" model="ir.ui.view">
        <field name="name">mediflow.queue.tree</field>
        <field name="model">mediflow.queue</field>
        <field name="arch" type="xml">
            <list string="Queues">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="service_point"/>
                <field name="waiting_count"/>
                <field name="serving_count"/>
                <field name="avg_wait_minutes"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_queue_form" model="ir.ui.view">
        <field name="name">mediflow.queue.form</field>
        <field name="model">mediflow.queue</field>
        <field name="arch" type="xml">
            <form string="Queue">
                <header>
                    <button name="action_call_next" type="object" string="Call Next"
                            class="btn-primary"/>
                    <button name="action_open_board" type="object" string="Open Board"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="service_point"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="waiting_count"/>
                            <field name="serving_count"/>
                            <field name="avg_wait_minutes"/>
                        </group>
                    </group>
                    <field name="entry_ids" context="{'default_queue_id': id}">
                        <list>
                            <field name="token"/>
                            <field name="patient_id"/>
                            <field name="priority"/>
                            <field name="state"/>
                            <field name="wait_minutes"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mediflow_queue" model="ir.actions.act_window">
        <field name="name">Queues</field>
        <field name="res_model">mediflow.queue</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
