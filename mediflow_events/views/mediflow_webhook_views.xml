<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mediflow_webhook_tree" model="ir.ui.view">
        <field name="name">mediflow.webhook.tree</field>
        <field name="model">mediflow.webhook</field>
        <field name="arch" type="xml">
            <list string="Webhooks">
                <field name="name"/>
                <field name="event_pattern"/>
                <field name="url"/>
                <field name="company_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_mediflow_webhook_form" model="ir.ui.view">
        <field name="name">mediflow.webhook.form</field>
        <field name="model">mediflow.webhook</field>
        <field name="arch" type="xml">
            <form string="Webhook Subscription">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="event_pattern"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="url"/>
                            <field name="secret" password="True"/>
                            <field name="timeout"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mediflow_webhook" model="ir.actions.act_window">
        <field name="name">Webhooks</field>
        <field name="res_model">mediflow.webhook</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
