<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Surface no-show risk on the appointment form -->
    <record id="view_mediflow_appointment_form_ai" model="ir.ui.view">
        <field name="name">mediflow.appointment.form.ai</field>
        <field name="model">mediflow.appointment</field>
        <field name="inherit_id" ref="mediflow_appointment.view_mediflow_appointment_form"/>
        <field name="arch" type="xml">
            <field name="walk_in" position="after">
                <field name="mf_no_show_band" widget="badge"
                       decoration-success="mf_no_show_band == 'low'"
                       decoration-warning="mf_no_show_band == 'medium'"
                       decoration-danger="mf_no_show_band == 'high'"/>
                <field name="mf_no_show_score"/>
                <field name="mf_risk_factors"/>
            </field>
        </field>
    </record>

    <!-- Surface risk band on the appointment list -->
    <record id="view_mediflow_appointment_list_ai" model="ir.ui.view">
        <field name="name">mediflow.appointment.list.ai</field>
        <field name="model">mediflow.appointment</field>
        <field name="inherit_id" ref="mediflow_appointment.view_mediflow_appointment_tree"/>
        <field name="arch" type="xml">
            <field name="walk_in" position="after">
                <field name="mf_no_show_band" widget="badge"
                       decoration-success="mf_no_show_band == 'low'"
                       decoration-warning="mf_no_show_band == 'medium'"
                       decoration-danger="mf_no_show_band == 'high'"/>
            </field>
        </field>
    </record>

    <!-- Filter and group by risk -->
    <record id="view_mediflow_appointment_search_ai" model="ir.ui.view">
        <field name="name">mediflow.appointment.search.ai</field>
        <field name="model">mediflow.appointment</field>
        <field name="inherit_id" ref="mediflow_appointment.view_mediflow_appointment_search"/>
        <field name="arch" type="xml">
            <filter name="confirmed" position="after">
                <separator/>
                <filter name="high_risk" string="High No-show Risk"
                        domain="[('mf_no_show_band','=','high')]"/>
            </filter>
            <filter name="group_state" position="after">
                <filter name="group_risk" string="Risk Band"
                        context="{'group_by':'mf_no_show_band'}"/>
            </filter>
        </field>
    </record>

</odoo>
