<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="rule_appointment_company" model="ir.rule">
        <field name="name">Appointment: multi-clinic isolation</field>
        <field name="model_id" ref="model_mediflow_appointment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_slot_company" model="ir.rule">
        <field name="name">Slot: multi-clinic isolation</field>
        <field name="model_id" ref="model_mediflow_appointment_slot"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_schedule_company" model="ir.rule">
        <field name="name">Schedule: multi-clinic isolation</field>
        <field name="model_id" ref="model_mediflow_schedule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_resource_company" model="ir.rule">
        <field name="name">Resource: multi-clinic isolation</field>
        <field name="model_id" ref="model_mediflow_resource"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
